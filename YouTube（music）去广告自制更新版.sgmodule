#!name=YouTube（music）去广告自制更新版
#!desc=固定版 Maasea Enhance + 自制 Raw Protobuf AdGuard v12。/browse、/next、/player/ad_break 由独立原始 protobuf 过滤器处理；其余播放器增强继续使用固定 Maasea。双语字幕保持完全独立。
#!category=YouTube
#!system=ios
#!version=2026.09.15.7
#!arguments=屏蔽上传按钮:true,屏蔽选段按钮:true,屏蔽Shorts按钮:false,启用调试模式:false
#!arguments-desc=- 屏蔽参数：[true, false] \n\n1. 双语字幕继续由独立模块负责，本模块不处理 timedtext/caption。\n2. Maasea Enhance 固定为 65075cdb388fc5e3094afd7e7314c67b243f3525（2026-07-19）。\n3. /browse 使用 Raw AdGuard v12 清理 Home Feed Sponsored。\n4. /next 使用 Raw AdGuard v12 清理新版 companion / engagement Sponsored，包括 HAR 中出现于 unknown field 14/15/37/42/777 的广告容器。\n5. /player/ad_break 独立广告响应直接清空。\n6. /player、/search、/reel、/guide、/get_watch 等继续由固定 Maasea Enhance 处理。\n7. captionLang 强制 off，避免与双语字幕模块功能重叠。

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT

[Script]
# 自制原始 protobuf 广告兜底：三条广告数据路径独占，避免 response 脚本竞争
YouTube.RawAdGuard.v12 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player\/ad_break)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,debug=true,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/YouTube.HomeFeedAdBlock.js?v=20260915.12

# 固定 Maasea Enhance：刻意排除 browse / next / player/ad_break
YouTube.Enhance.response.pinned = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/Upstream/Maasea/Script/Youtube/youtube.response.js,argument="{\"captionLang\":\"off\",\"blockUpload\":{{{屏蔽上传按钮}}},\"blockImmersive\":{{{屏蔽选段按钮}}},\"blockShorts\":{{{屏蔽Shorts按钮}}},\"debug\":{{{启用调试模式}}}}"

YouTube.Enhance.request.init.pinned = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/Upstream/Maasea/Script/Youtube/youtube.request.js,argument="{\"captionLang\":\"off\"}"
YouTube.Enhance.request.log_event.pinned = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/Upstream/Maasea/Script/Youtube/youtube.request.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
