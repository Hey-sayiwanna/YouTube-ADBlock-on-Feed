#!name=YouTube 首页广告去除
#!desc=恢复稳定版：仅处理 YouTube iOS 首页 /browse Sponsored 信息流广告；不处理视频广告、/next、/player、/player/ad_break、/get_watch、initplayback，也不包含 Maasea Enhance。可与其他 YouTube 视频去广告/双语字幕模块分开使用。
#!category=YouTube
#!system=ios
#!version=2026.09.15.homefeed-only

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Script]
YouTube.HomeFeed.STABLE-v9-JSC = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,debug=false,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/YouTube.HomeFeedAdBlock.js?v=homefeed-only

[MITM]
hostname = %APPEND% youtubei.googleapis.com
