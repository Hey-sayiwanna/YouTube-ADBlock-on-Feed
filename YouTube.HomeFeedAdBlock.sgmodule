#!name=YouTube（music）去广告自制更新版
#!desc=2026-09-15 v12 排障版：稳定 HomeFeed v9 改用 JSC，彻底移除实验 NextAdBlock；/next 回归固定 Maasea；继续追踪新版 initplayback/UMP 视频广告链。双语字幕独立。
#!category=YouTube
#!system=ios
#!version=2026.09.15.12
#!arguments=屏蔽上传按钮:true,屏蔽选段按钮:true,屏蔽Shorts按钮:false,启用调试模式:false
#!arguments-desc=- 屏蔽参数：[true, false] \n\n1. /browse 仅运行稳定 HomeFeed v9，并强制 JSC，避免 WebView 冷启动开销。\n2. /next 不运行任何自制 NextAdBlock，完全交给固定 Maasea Enhance。\n3. /player/ad_break 继续返回空 protobuf。\n4. /player、/next、/search、/reel、/guide、/get_watch、/log_event、/config 使用固定 Maasea Enhance。\n5. initplayback 继续使用 Maasea 新版 UMP 请求链；当前重点排查视频广告与 companion 卡片同一会话。\n6. captionLang 强制 off，双语字幕继续由独立模块负责。

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT

[Script]
YouTube.HomeFeed.STABLE-v9-JSC = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,debug=false,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/YouTube.HomeFeedAdBlock.js?v=20260915.12
YouTube.AdBreakBlock.v2 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,debug=false,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/YouTube.AdBreakBlock.js?v=20260915.12
YouTube.Enhance.response.pinned-v12 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/Upstream/Maasea/Script/Youtube/youtube.response.js?v=20260915.12,argument="{\"captionLang\":\"off\",\"blockUpload\":{{{屏蔽上传按钮}}},\"blockImmersive\":{{{屏蔽选段按钮}}},\"blockShorts\":{{{屏蔽Shorts按钮}}},\"debug\":{{{启用调试模式}}}}"
YouTube.Enhance.request.init.pinned-v12 = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/Upstream/Maasea/Script/Youtube/youtube.request.js?v=20260915.12,argument="{\"captionLang\":\"off\"}"
YouTube.Enhance.request.log_event.pinned-v12 = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/Upstream/Maasea/Script/Youtube/youtube.request.js?v=20260915.12

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
