#!name=YouTube（music）去广告自制更新版
#!desc=以固定版 Maasea YouTube (Music) Enhance 为基础；修复合并脚本对 Surge 二进制响应类型处理，并重置此前合并测试可能污染的 Enhance 广告识别缓存。/browse 先执行已验证 Home Feed v9，再交给原版 Enhance；不新增 player/ad_break 处理。
#!category=YouTube
#!system=ios
#!version=2026.09.15.6
#!arguments=屏蔽上传按钮:true,屏蔽选段按钮:true,屏蔽Shorts按钮:false,启用调试模式:false
#!arguments-desc=- 屏蔽参数：[true, false] \n\n1. 双语字幕继续由独立模块负责，本模块不提供字幕翻译开关。\n2. 固定版 Maasea Enhance：65075cdb388fc5e3094afd7e7314c67b243f3525（2026-07-19）。\n3. /browse 只命中一个合并 response：先把 Surge body 显式规范为 Uint8Array，再运行 Home Feed v9，随后运行原版 Enhance Browse。\n4. 本版把 Enhance 自适应广告缓存版本升级一次，自动丢弃此前错误合并版本可能写入的 stale whiteNo/whiteEml，恢复 /next、/browse 等原版识别。\n5. 不单独处理 /player/ad_break；先恢复迁移前原版功能边界。\n6. captionLang 强制为 off，避免与双语字幕模块重叠。

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT

[Script]
YouTube.Enhance.response.merged = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/Upstream/Maasea/Script/Youtube/youtube.response.merged.js?v=20260915.6,argument="{\"captionLang\":\"off\",\"blockUpload\":{{{屏蔽上传按钮}}},\"blockImmersive\":{{{屏蔽选段按钮}}},\"blockShorts\":{{{屏蔽Shorts按钮}}},\"debug\":{{{启用调试模式}}}}"

YouTube.Enhance.request.init.pinned = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/Upstream/Maasea/Script/Youtube/youtube.request.js,argument="{\"captionLang\":\"off\"}"
YouTube.Enhance.request.log_event.pinned = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/Upstream/Maasea/Script/Youtube/youtube.request.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
